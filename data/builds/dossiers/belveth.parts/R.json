 "mechanics": [
  {
   "claim": "Every attack on-hit against the marked target deals bonus true damage and generates a stack that increases this damage, stacking infinitely.",
   "quote": "Every attack {{tip|on-hit}} against the marked target deals {{as|'''bonus''' true damage}} and generates a stack of ''Endless Banquet'' that increases this damage by the same value. This effect stacks infinitely",
   "affectsDamageFight": true
  },
  {
   "claim": "Against epic monsters the stacking bonus true damage is capped at 8 stacks.",
   "quote": "capped at 8 stacks against epic {{tip|monsters}}",
   "affectsDamageFight": true
  },
  {
   "claim": "The bonus true damage applies as proc (on-hit) damage; the explosion deals area damage as a separate instance.",
   "quote": "Applies {{tip|proc damage}} on the bonus true damage and deals {{tip|area damage}} on the explosion.",
   "affectsDamageFight": true
  },
  {
   "claim": "The explosion's missing-health component is calculated before the flat base damage is applied.",
   "quote": "''Endless Banquet's'' true damage based on the target's missing health is calculated ''before'' the base damage is dealt.",
   "affectsDamageFight": true
  },
  {
   "claim": "The explosion's damage versus monsters is capped at 1500 true damage.",
   "quote": "capped at {{as|1500|true damage}} versus monsters",
   "affectsDamageFight": true
  },
  {
   "claim": "Bel'Veth gains the bonus health and heal from Endless Banquet at the start of the cast time, not on completion.",
   "quote": "'''Bel'Veth''' gains the '''bonus''' health and heal from ''Endless Banquet'' at the start of the cast time.",
   "affectsDamageFight": false
  },
  {
   "claim": "The passive bonus true damage is affected by the on-hit modifier of Royal Maelstrom (E).",
   "quote": "The passive {{as|'''bonus''' true damage}} is affected by the {{tip|on-hit}} modifier of {{ai|Royal Maelstrom|Bel'Veth}}.",
   "affectsDamageFight": true
  }

{
 "_comment": [
  "Which trait bonuses the TFT engine models, keyed by trait apiName. A trait's numbers live in its curve",
  "table with one column per breakpoint; `col` defaults to the breakpoint being simulated and can be pinned.",
  "`stats` keys: adPct, ap (scale 100 turns a fraction into flat ability power), asPct, crit, amp, manaRegen,",
  "hp, hpMult, adap (both attack damage and ability power), adOrAp (whichever the unit's variant scales).",
  "Other effects: precision, asPerAttackStack (+maxStacks), apPerCast, ampAfterSameTarget, bleed, burnOnHit,",
  "bonusMagicPct, ravager, pixies, riftbeast, ownMultiplier, caustic, summoner (rows the unit's summons read);",
  "and for the fights where the dummies hit back: durability, shieldAtStart, shieldAtHp, resistsPerAttacker,",
  "omnivamp, takedown (healPct, mana), faeHeal. Traits absent here are reported as unmodeled."
 ],
 "DA_18_Hunter": {"stats": {"adPct": {"row": "HunterAD"}},
  "ampAfterSameTarget": {"amp": {"row": "DamageAmp", "col": 1}, "seconds": {"row": "HunterDuration", "col": 1}}},
 "DA_18_Blossom": {"stats": {"adap": {"row": "ADAP"}, "hpMult": {"row": "BonusHealth", "col": 1}},
  "note": "the Wisp economy is not modeled"},
 "DA_18_Spellweaver": {"stats": {"ap": [{"row": "TeamwideAP", "col": 1, "scale": 100}, {"row": "SpellweaverAP", "scale": 100}]},
  "apPerCast": {"row": "APPerCast"}},
 "DA_18_Rapidfire": {"stats": {"asPct": {"row": "TeamAS", "col": 1, "minusOne": true}},
  "asPerAttackStack": {"row": "ASPerAttack", "minusOne": true}, "maxStacks": {"row": "MaxStacks", "col": 1}},
 "DA_18_Executioner": {"precision": true, "stats": {"crit": {"row": "CritChance", "col": 1}},
  "bleed": {"pct": {"row": "BonusBleedPercent"}, "duration": {"row": "BleedDuration", "col": 2}}},
 "DA_18_Lunar": {"stats": {"asPct": {"row": "AttackSpeed", "minusOne": true}, "ap": {"row": "AbilityPower", "scale": 100}},
  "ownMultiplier": {"row": "LunarMultiplier", "col": 1}},
 "DA_18_Inferno": {"burnOnHit": {"pct": {"row": "HPBurnPerSecond", "scale": 0.01}, "duration": {"row": "Duration", "col": 1}},
  "note": "the shop ignition is not modeled; the burn stacks with item burns"},
 "DA_18_Adaptor": {"stats": {"adOrAp": {"row": "ADAPGain"}}},
 "DA_18_Slayer": {"ravager": {"amp": {"row": "BonusDamagePercentBase"}, "threshold": {"row": "EnemyHealthThreshold", "col": 1},
   "multiplier": {"row": "UnderThresholdMultiplier", "col": 1}}, "omnivamp": {"row": "Omnivamp", "col": 1}},
 "DA_18_Solar": {"bonusMagicPct": {"row": "BonusMagicDamage", "col": 1},
  "note": "the shield and the 3-star bonuses are not modeled"},
 "DA_18_Fae": {"pixies": {"count": [3, 7], "adapPerPixie": {"row": "ADAP", "scale": 0.01}},
  "faeHeal": {"threshold": {"row": "HealThreshold"}, "healPerPixie": {"row": "Heal", "scale": 0.01}, "count": [3, 7]},
  "note": "pixies are assumed at 3 (first breakpoint) and 7 (second); the heal below half health is read as a share of max health per pixie"},
 "DA_18_Invoker": {"stats": {"manaRegen": [{"row": "TeamManaRegen"}, {"row": "InvokerManaBonus"}]}},
 "DA_Riftbeast18": {"riftbeast": true, "note": "the Alpha Mark is assumed on this unit; the (7) growth is not modeled"},
 "DA_Primal18": {"stats": {"asPct": {"row": "TigerAttackSpeedPrimal", "col": 1, "minusOne": true}},
  "note": "the Tiger blessing is assumed"},
 "DA_18_Vanguard": {"shieldAtStart": {"pct": {"row": "MaxHealthShield"}, "duration": {"row": "ShieldDuration", "col": 1}},
  "shieldAtHp": {"threshold": {"row": "HealthThreshold", "col": 1}, "pct": {"row": "MaxHealthShield"}, "duration": {"row": "ShieldDuration", "col": 1}},
  "durability": {"row": "DurabilityIncrease", "minusOne": true, "scale": -1}},
 "DA_Juggernaut18": {"durability": {"row": "JuggernautDurability", "minusOne": true, "scale": -1},
  "note": "the team's share is not modeled"},
 "DA_18_Defender": {"stats": {"armor": {"row": "DefenderDefenseGain"}, "mr": {"row": "DefenderDefenseGain"}}},
 "DA_18_Brawler": {"stats": {"hp": {"row": "BrawlerTeamHealth", "col": 1}, "hpMult": [1, {"row": "BrawlerHealthPercent"}]}},
 "DA_18_Battlemage": {"resistsPerAttacker": {"armor": {"row": "Resists"}, "mr": {"row": "Resists"}}},
 "DA_18_ZyraUniqueTrait": {"durability": {"row": "BaseDurability", "minusOne": true, "scale": -1},
  "note": "the higher durability with six plants alive is not modeled"},
 "DA_FloraFatalis18": {"takedown": {"healPct": {"row": "PercentHeal"}, "mana": {"row": "Mana"}}},
 "DA_18_Summoner": {"summoner": {"damageMult": {"row": "DamageMult"}, "healthMult": {"row": "HealthMult"},
  "extraSummons": {"row": "ExtraSummons"}, "extraAttacks": {"row": "NumExtraAttacks"}, "summonPower": {"row": "SummonPower"}}},
 "DA_18_Caustic": {"caustic": {"pct": {"row": "ShredPercent", "col": 1, "scale": 0.01}, "duration": {"row": "ShredDuration", "col": 1}}}
}

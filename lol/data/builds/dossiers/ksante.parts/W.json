 "mechanics": [
  {
   "claim": "Upon entering All Out, Path Maker's cooldown is fully refreshed, letting it be recast immediately.",
   "quote": "Upon entering ''All Out'', ''Path Maker's'' {{sti|cooldown}} is refreshed.",
   "affectsDamageFight": true
  },
  {
   "claim": "While charging, K'Sante gains displacement immunity and 30% damage reduction, reducing incoming damage during the wind-up.",
   "quote": "gains {{tip|displacement immunity}} and 30% damage reduction",
   "affectsDamageFight": false
  },
  {
   "claim": "During All Out, the recast deals bonus true damage instead of the normal physical damage/knockback/stun, and its damage reduction rises to 75% while dash speed increases 20%.",
   "quote": "''Path Maker'' no longer applies its {{tip|airborne|knock back}} and {{tip|stun}}, but its damage reduction is increased to 75%, the dash deals {{sti|true damage|...bonus true damage}}, and the dash speed is increased by 20%.",
   "affectsDamageFight": true
  },
  {
   "claim": "Path Maker's cooldown starts only after the dash/recast resolves, not on initial cast.",
   "quote": "cdstart          = post-effect",
   "affectsDamageFight": true
  },
  {
   "claim": "The channel (and thus the eventual recast) cannot be interrupted by crowd control.",
   "quote": "''Path Maker's'' charge cannot be {{tip|interrupt|interrupted}} by {{tip|crowd control}}.",
   "affectsDamageFight": true
  }
 ],

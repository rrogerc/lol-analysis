 "mechanics": [
  {
   "claim": "Subsequent Stone Shard hits on the same target within one cast deal only 40% damage.",
   "quote": "Subsequent hits deal 40% damage.",
   "affectsDamageFight": true
  },
  {
   "claim": "Taliyah is unable to basic attack until she launches the third Stone Shard, but can move and cast other abilities during the barrage.",
   "quote": "is unable to basic attack until she launches the third ''Stone Shard''.",
   "affectsDamageFight": true
  },
  {
   "claim": "Casting Q while standing in Worked Ground consumes it and empowers the cast into the Boulder, with the primary target taking 180% damage.",
   "quote": "dealing {{ccs|180%|magic}} damage to them",
   "affectsDamageFight": true
  },
  {
   "claim": "Against monsters, each Stone Shard deals bonus flat magic damage, and the Boulder deals 80% bonus damage to the primary target, both unaffected by the subsequent-hit reduction.",
   "quote": "This '''bonus''' damage is unaffected by the damage modifier from subsequent hits.",
   "affectsDamageFight": true
  },
  {
   "claim": "Spell shield only blocks one instance of Q's damage (not all five Stone Shards).",
   "quote": "{{tip|Spell shield}} only prevents one instance of damage.",
   "affectsDamageFight": true
  },
  {
   "claim": "Each Stone Shard hit is a separate area-damage instance; the first is area damage, later ones are persistent area damage; the Boulder applies area damage.",
   "quote": "The first ''Stone Shard'' hit on each target is considered {{tip|area damage}}, while additional ones of the same cast are considered {{tip|persistent area damage}}.",
   "affectsDamageFight": true
  },
  {
   "claim": "The five Stone Shards launch on a staggered timeline: first instantly after cast time, second/third over 1 second, fourth/fifth over 0.5 seconds more.",
   "quote": "The first ''Stone Shard'' is launched instantly after the cast time ends, then the second and third ''Stone Shards'' are both launched over 1 second, and finally the fourth and fifth ''Stone Shards'' are both launched over {{fd|0.5}} seconds.",
   "affectsDamageFight": true
  }
 ],
